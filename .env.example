# ─── Required in production ────────────────────────────────────────────────
# Canonical origin of the live site (no trailing slash). Used for canonical
# URLs, hreflang, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://asteroid.design

# ─── Search engine verification (optional, paste the token only) ──────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# ─── Analytics (optional) ──────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
